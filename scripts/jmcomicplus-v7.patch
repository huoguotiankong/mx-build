     private fun imageShunt() = preferences.getString(PREF_SHUNT, "1").orEmpty().ifBlank { "1" }
 
+    private fun webCoverUrl(doc: Document, base: String, id: String): String? {
+        val img = doc.selectFirst(".thumb-overlay > img") ?: return null
+        val raw = img.attr("data-original")
+            .ifBlank { img.attr("data-src").ifBlank { img.attr("data-cfsrc").ifBlank { img.attr("src") } } }
+        val absolute = absoluteUrl(base, raw).substringBefore('?')
+        if (absolute.isBlank()) return null
+
+        val file = absolute.substringAfterLast('/')
+        if (Regex("_3x4\\.[A-Za-z0-9]+$", RegexOption.IGNORE_CASE).containsMatchIn(file)) {
+            return absolute
+        }
+
+        val dot = absolute.lastIndexOf('.')
+        val slash = absolute.lastIndexOf('/')
+        return if (dot > slash) {
+            absolute.substring(0, dot) + "_3x4" + absolute.substring(dot)
+        } else {
+            "${absolute.trimEnd('/')}_3x4.jpg"
+        }
+    }
